# ── Anthropic Claude API ────────────────────────────────────────────
# Required for the intelligence layer (5-section report generation).
# Without this, a deterministic template report is used instead.
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Earth Engine ─────────────────────────────────────────────
# Option A: OAuth (user account) — just set GEE_PROJECT, then run:
#   earthengine authenticate
GEE_PROJECT=your-gee-project-id

# Option B: Service account (CI/server deployments)
# GEE_SERVICE_ACCOUNT=your-sa@project.iam.gserviceaccount.com
# GEE_KEY_FILE=/path/to/service-account-key.json

# ── Maxar Geospatial Platform ────────────────────────────────────────
# Obtain from: https://developers.maxar.com/docs/authentication/
# Without this, simulated scene catalog is used.
MAXAR_API_KEY=your-maxar-bearer-token
